# ============================================================
# VoiceNoteX Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit your real .env file to GitHub.
# ============================================================

# ── AI Services ────────────────────────────────────────────

# Groq API Key (used for the LLM / note generation)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Deepgram API Key (used for audio transcription)
# Get yours at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Database ────────────────────────────────────────────────

# MongoDB connection string
# Local (default):  mongodb://127.0.0.1:27017
# MongoDB Atlas:    mongodb+srv://user:pass@cluster.mongodb.net/voicenotex
MONGO_URI=mongodb://127.0.0.1:27017

# ── Security ────────────────────────────────────────────────

# JWT Secret — change this to a long random string!
# You can generate one at: https://randomkeygen.com
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
